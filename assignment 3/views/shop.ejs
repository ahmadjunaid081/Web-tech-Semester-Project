<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <style>
            /* Shop Page Specific Styles */
            .shop-container {
                display: grid;
                grid-template-columns: 280px 1fr;
                gap: 30px;
                padding: 40px 0;
            }

            .filter-sidebar {
                background: #f9f9f9;
                padding: 25px;
                border-radius: 8px;
                height: fit-content;
                position: sticky;
                top: 110px;
            }

            .filter-section {
                margin-bottom: 25px;
            }

            .filter-section h4 {
                font-size: 14px;
                text-transform: uppercase;
                color: #333;
                margin-bottom: 15px;
                padding-bottom: 10px;
                border-bottom: 2px solid #e00;
            }

            .filter-options label {
                display: block;
                padding: 8px 0;
                cursor: pointer;
                transition: color 0.2s;
            }

            .filter-options label:hover {
                color: #e00;
            }

            .filter-options input[type="radio"],
            .filter-options input[type="checkbox"] {
                margin-right: 10px;
                accent-color: #e00;
            }

            .price-inputs {
                display: flex;
                gap: 10px;
                align-items: center;
            }

            .price-inputs input {
                width: 80px;
                padding: 8px;
                border: 1px solid #ddd;
                border-radius: 4px;
            }

            .filter-btn {
                width: 100%;
                margin-top: 15px;
            }

            .shop-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
                padding-bottom: 15px;
                border-bottom: 1px solid #eee;
            }

            .shop-header h1 {
                font-size: 1.8rem;
                font-weight: 300;
            }

            .results-info {
                color: #666;
                font-size: 14px;
            }

            .sort-select {
                padding: 8px 15px;
                border: 1px solid #ddd;
                border-radius: 4px;
                background: #fff;
            }

            .products-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 25px;
            }

            .products-grid .product-card {
                width: 100%;
            }

            /* Pagination Styles */
            .pagination-container {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 10px;
                margin-top: 40px;
                padding-top: 30px;
                border-top: 1px solid #eee;
            }

            .pagination-btn {
                padding: 10px 18px;
                border: 1px solid #ddd;
                background: #fff;
                color: #333;
                text-decoration: none;
                border-radius: 4px;
                transition: all 0.2s;
            }

            .pagination-btn:hover:not(.disabled):not(.active) {
                background: #e00;
                color: #fff;
                border-color: #e00;
            }

            .pagination-btn.active {
                background: #e00;
                color: #fff;
                border-color: #e00;
            }

            .pagination-btn.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

            .pagination-info {
                color: #666;
                font-size: 14px;
                margin: 0 15px;
            }

            .active-filters {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 20px;
            }

            .filter-tag {
                background: #e00;
                color: #fff;
                padding: 5px 12px;
                border-radius: 20px;
                font-size: 12px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .filter-tag a {
                color: #fff;
                font-weight: bold;
            }

            .clear-filters {
                color: #e00;
                text-decoration: underline;
                font-size: 13px;
            }

            .no-products-message {
                grid-column: 1 / -1;
                text-align: center;
                padding: 60px;
                color: #666;
            }

            @media (max-width: 992px) {
                .shop-container {
                    grid-template-columns: 1fr;
                }

                .filter-sidebar {
                    position: static;
                }

                .products-grid {
                    grid-template-columns: repeat(3, 1fr);
                }
            }

            @media (max-width: 768px) {
                .products-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
        </style>
</head>

<body id="shop-page">
    <div id="wrapper">
        <div id="Header_wrapper" class="subheader-bg">
            <%- include('partials/header') %>
                <div id="Subheader">
                    <div class="container">
                        <h1>Shop</h1>
                    </div>
                </div>
        </div>

        <main id="Content">
            <div class="container shop-container">
                <!-- Filter Sidebar -->
                <aside class="filter-sidebar">
                    <form action="/shop" method="GET" id="filter-form">
                        <!-- Category Filter -->
                        <div class="filter-section">
                            <h4>Category</h4>
                            <div class="filter-options">
                                <label>
                                    <input type="radio" name="category" value="all" <%=filters.category==='all'
                                        ? 'checked' : '' %>>
                                    All Categories
                                </label>
                                <% categories.forEach(function(cat) { %>
                                    <label>
                                        <input type="radio" name="category" value="<%= cat %>" <%=filters.category===cat
                                            ? 'checked' : '' %>>
                                        <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
                                    </label>
                                    <% }); %>
                            </div>
                        </div>

                        <!-- Gender Filter -->
                        <div class="filter-section">
                            <h4>Gender</h4>
                            <div class="filter-options">
                                <label>
                                    <input type="radio" name="gender" value="all" <%=filters.gender==='all' ? 'checked'
                                        : '' %>>
                                    All
                                </label>
                                <label>
                                    <input type="radio" name="gender" value="for-her" <%=filters.gender==='for-her'
                                        ? 'checked' : '' %>>
                                    For Her
                                </label>
                                <label>
                                    <input type="radio" name="gender" value="for-him" <%=filters.gender==='for-him'
                                        ? 'checked' : '' %>>
                                    For Him
                                </label>
                            </div>
                        </div>

                        <!-- Price Range Filter -->
                        <div class="filter-section">
                            <h4>Price Range</h4>
                            <div class="price-inputs">
                                <input type="number" name="minPrice" placeholder="Min" value="<%= filters.minPrice %>"
                                    min="0">
                                <span>-</span>
                                <input type="number" name="maxPrice" placeholder="Max" value="<%= filters.maxPrice %>"
                                    min="0">
                            </div>
                        </div>

                        <!-- Sort -->
                        <div class="filter-section">
                            <h4>Sort By</h4>
                            <select name="sort" class="form-select">
                                <option value="newest" <%=filters.sort==='newest' ? 'selected' : '' %>>Newest</option>
                                <option value="price_asc" <%=filters.sort==='price_asc' ? 'selected' : '' %>>Price: Low
                                    to High</option>
                                <option value="price_desc" <%=filters.sort==='price_desc' ? 'selected' : '' %>>Price:
                                    High to Low</option>
                                <option value="name" <%=filters.sort==='name' ? 'selected' : '' %>>Name: A-Z</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary filter-btn">Apply Filters</button>
                        <a href="/shop" class="btn btn-outline-secondary filter-btn">Clear All</a>
                    </form>
                </aside>

                <!-- Products Section -->
                <section class="products-section">
                    <div class="shop-header">
                        <div>
                            <h1>Products</h1>
                            <p class="results-info">
                                Showing <%= products.length %> of <%= pagination.totalProducts %> products
                                        <% if (filters.category !=='all' || filters.gender !=='all' ) { %>
                                            (filtered)
                                            <% } %>
                            </p>
                        </div>
                    </div>

                    <!-- Active Filters Display -->
                    <% if (filters.category !=='all' || filters.gender !=='all' || filters.minPrice || filters.maxPrice)
                        { %>
                        <div class="active-filters">
                            <% if (filters.category !=='all' ) { %>
                                <span class="filter-tag">
                                    Category: <%= filters.category %>
                                        <a href="/shop?gender=<%= filters.gender %>&sort=<%= filters.sort %>">×</a>
                                </span>
                                <% } %>
                                    <% if (filters.gender !=='all' ) { %>
                                        <span class="filter-tag">
                                            Gender: <%= filters.gender %>
                                                <a
                                                    href="/shop?category=<%= filters.category %>&sort=<%= filters.sort %>">×</a>
                                        </span>
                                        <% } %>
                                            <% if (filters.minPrice || filters.maxPrice) { %>
                                                <span class="filter-tag">
                                                    Price: £<%= filters.minPrice || '0' %> - £<%= filters.maxPrice
                                                            || '∞' %>
                                                            <a
                                                                href="/shop?category=<%= filters.category %>&gender=<%= filters.gender %>&sort=<%= filters.sort %>">×</a>
                                                </span>
                                                <% } %>
                                                    <a href="/shop" class="clear-filters">Clear all filters</a>
                        </div>
                        <% } %>

                            <!-- Products Grid -->
                            <div class="products-grid">
                                <% if (products && products.length> 0) { %>
                                    <% products.forEach(function(product) { %>
                                        <%- include('partials/product-card', { product: product }) %>
                                            <% }); %>
                                                <% } else { %>
                                                    <div class="no-products-message">
                                                        <h3>No products found</h3>
                                                        <p>Try adjusting your filters or <a href="/shop">view all
                                                                products</a>.</p>
                                                    </div>
                                                    <% } %>
                            </div>

                            <!-- Pagination -->
                            <% if (pagination.totalPages> 1) { %>
                                <div class="pagination-container">
                                    <% var startPage=Math.max(1, pagination.currentPage - 2); var
                                        endPage=Math.min(pagination.totalPages, pagination.currentPage + 2); function
                                        buildQuery(page) { var query='?page=' + page + '&limit=' + pagination.limit; if
                                        (filters.category !=='all' ) query +='&category=' + filters.category; if
                                        (filters.gender !=='all' ) query +='&gender=' + filters.gender; if
                                        (filters.minPrice) query +='&minPrice=' + filters.minPrice; if
                                        (filters.maxPrice) query +='&maxPrice=' + filters.maxPrice; if (filters.sort)
                                        query +='&sort=' + filters.sort; return query; } %>

                                        <!-- Previous Button -->
                                        <% if (pagination.hasPrevPage) { %>
                                            <a href="/shop<%= buildQuery(pagination.currentPage - 1) %>"
                                                class="pagination-btn">← Previous</a>
                                            <% } else { %>
                                                <span class="pagination-btn disabled">← Previous</span>
                                                <% } %>

                                                    <!-- Page Numbers -->
                                                    <% if (startPage> 1) { %>
                                                        <a href="/shop<%= buildQuery(1) %>" class="pagination-btn">1</a>
                                                        <% if (startPage> 2) { %>
                                                            <span class="pagination-info">...</span>
                                                            <% } %>
                                                                <% } %>

                                                                    <% for (var i=startPage; i <=endPage; i++) { %>
                                                                        <a href="/shop<%= buildQuery(i) %>"
                                                                            class="pagination-btn <%= i === pagination.currentPage ? 'active' : '' %>">
                                                                            <%= i %>
                                                                        </a>
                                                                        <% } %>

                                                                            <% if (endPage < pagination.totalPages) { %>
                                                                                <% if (endPage < pagination.totalPages -
                                                                                    1) { %>
                                                                                    <span
                                                                                        class="pagination-info">...</span>
                                                                                    <% } %>
                                                                                        <a href="/shop<%= buildQuery(pagination.totalPages) %>"
                                                                                            class="pagination-btn">
                                                                                            <%= pagination.totalPages %>
                                                                                        </a>
                                                                                        <% } %>

                                                                                            <!-- Next Button -->
                                                                                            <% if
                                                                                                (pagination.hasNextPage)
                                                                                                { %>
                                                                                                <a href="/shop<%= buildQuery(pagination.currentPage + 1) %>"
                                                                                                    class="pagination-btn">Next
                                                                                                    →</a>
                                                                                                <% } else { %>
                                                                                                    <span
                                                                                                        class="pagination-btn disabled">Next
                                                                                                        →</span>
                                                                                                    <% } %>
                                </div>

                                <p class="text-center mt-3 text-muted">
                                    Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
                                </p>
                                <% } %>
                </section>
            </div>
        </main>

        <%- include('partials/footer') %>
    </div>
    <%- include('partials/scripts', { includeValidation: false }) %>
</body>

</html>