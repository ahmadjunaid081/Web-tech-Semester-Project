<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | BeShop Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>

<body>
    <div class="admin-wrapper">
        <%- include('partials/admin-sidebar', { currentPage: 'dashboard' }) %>
            <div class="admin-main">
                <%- include('partials/admin-header') %>
                    <main class="admin-content">
                        <% if (success) { %>
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle me-2"></i>
                                <%= success %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>
                                <% if (error) { %>
                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                        <i class="bi bi-exclamation-circle me-2"></i>
                                        <%= error %>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                    <% } %>

                                        <!-- Stats Cards -->
                                        <div class="stats-grid">
                                            <div class="stat-card">
                                                <div class="stat-icon products">
                                                    <i class="bi bi-box-seam"></i>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.totalProducts || 0 %>
                                                    </h3>
                                                    <p>Total Products</p>
                                                </div>
                                            </div>
                                            <div class="stat-card">
                                                <div class="stat-icon her">
                                                    <i class="bi bi-gender-female"></i>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.forHerCount || 0 %>
                                                    </h3>
                                                    <p>For Her</p>
                                                </div>
                                            </div>
                                            <div class="stat-card">
                                                <div class="stat-icon him">
                                                    <i class="bi bi-gender-male"></i>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.forHimCount || 0 %>
                                                    </h3>
                                                    <p>For Him</p>
                                                </div>
                                            </div>
                                            <div class="stat-card">
                                                <div class="stat-icon featured">
                                                    <i class="bi bi-star-fill"></i>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.featuredCount || 0 %>
                                                    </h3>
                                                    <p>Featured</p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Category Breakdown -->
                                        <div class="row mt-4">
                                            <div class="col-md-6">
                                                <div class="admin-card">
                                                    <h4>Categories</h4>
                                                    <div class="category-list">
                                                        <div class="category-item">
                                                            <span><i class="bi bi-tag me-2"></i>Clothing</span>
                                                            <span class="badge bg-primary">
                                                                <%= stats.clothingCount || 0 %>
                                                            </span>
                                                        </div>
                                                        <div class="category-item">
                                                            <span><i class="bi bi-tag me-2"></i>Shoes</span>
                                                            <span class="badge bg-success">
                                                                <%= stats.shoesCount || 0 %>
                                                            </span>
                                                        </div>
                                                        <div class="category-item">
                                                            <span><i class="bi bi-tag me-2"></i>Accessories</span>
                                                            <span class="badge bg-warning text-dark">
                                                                <%= stats.accessoriesCount || 0 %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="admin-card">
                                                    <h4>Recent Products</h4>
                                                    <% if (recentProducts && recentProducts.length> 0) { %>
                                                        <table class="table table-sm">
                                                            <tbody>
                                                                <% recentProducts.forEach(function(product) { %>
                                                                    <tr>
                                                                        <td>
                                                                            <img src="<%= product.image %>"
                                                                                alt="<%= product.name %>"
                                                                                class="product-thumb">
                                                                        </td>
                                                                        <td>
                                                                            <%= product.name %>
                                                                        </td>
                                                                        <td class="text-end">£<%=
                                                                                product.price.toFixed(2) %>
                                                                        </td>
                                                                    </tr>
                                                                    <% }); %>
                                                            </tbody>
                                                        </table>
                                                        <% } else { %>
                                                            <p class="text-muted">No products yet.</p>
                                                            <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Quick Actions -->
                                        <div class="admin-card mt-4">
                                            <h4>Quick Actions</h4>
                                            <div class="quick-actions">
                                                <a href="/admin/products/add" class="btn btn-primary">
                                                    <i class="bi bi-plus-lg me-2"></i>Add New Product
                                                </a>
                                                <a href="/admin/products" class="btn btn-secondary">
                                                    <i class="bi bi-list-ul me-2"></i>View All Products
                                                </a>
                                                <a href="/" class="btn btn-outline-secondary" target="_blank">
                                                    <i class="bi bi-shop me-2"></i>View Store
                                                </a>
                                            </div>
                                        </div>
                    </main>
            </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>