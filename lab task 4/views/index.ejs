<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .hero {
            background: #e00;
            color: #fff;
            padding: 100px 0;
            text-align: center;
        }

        .product-card {
            border: 1px solid #eee;
            padding: 15px;
            margin: 10px 0;
        }

        .product-card img {
            max-width: 100%;
            height: 200px;
            object-fit: cover;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="/">Be<span style="color:#e00;">Shop</span></a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/admin">Admin Panel</a>
            </div>
        </div>
    </nav>

    <section class="hero">
        <div class="container">
            <h1>Welcome to BeShop</h1>
            <p>Your one-stop shop for fashion</p>
            <a href="/admin" class="btn btn-light btn-lg mt-3">Go to Admin Panel →</a>
        </div>
    </section>

    <section class="container my-5">
        <h2 class="text-center mb-4">Products For Her</h2>
        <div class="row">
            <% if (productsForHer && productsForHer.length> 0) { %>
                <% productsForHer.forEach(function(product) { %>
                    <div class="col-md-3">
                        <div class="product-card">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <h5 class="mt-2">
                                <%= product.name %>
                            </h5>
                            <p style="color:#e00;">£<%= product.price.toFixed(2) %>
                            </p>
                        </div>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <div class="col-12 text-center">
                                <p class="text-muted">No products available. <a href="/admin/products/add">Add
                                        products</a> from the admin panel.</p>
                            </div>
                            <% } %>
        </div>
    </section>

    <section class="container my-5">
        <h2 class="text-center mb-4">Products For Him</h2>
        <div class="row">
            <% if (productsForHim && productsForHim.length> 0) { %>
                <% productsForHim.forEach(function(product) { %>
                    <div class="col-md-3">
                        <div class="product-card">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <h5 class="mt-2">
                                <%= product.name %>
                            </h5>
                            <p style="color:#e00;">£<%= product.price.toFixed(2) %>
                            </p>
                        </div>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <div class="col-12 text-center">
                                <p class="text-muted">No products available. <a href="/admin/products/add">Add
                                        products</a> from the admin panel.</p>
                            </div>
                            <% } %>
        </div>
    </section>

    <footer class="bg-dark text-white text-center py-4">
        <p class="mb-0">© 2024 BeShop. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>