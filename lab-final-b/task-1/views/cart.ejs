<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar-brand span {
            color: #e00;
        }

        .btn-primary {
            background: #e00;
            border-color: #e00;
        }

        .btn-primary:hover {
            background: #c00;
            border-color: #c00;
        }

        .cart-item img {
            width: 60px;
            height: 60px;
            object-fit: cover;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/">Be<span>Shop</span></a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Products</a>
                <a class="nav-link active" href="/cart">Cart (<%= cartCount %>)</a>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <h2 class="mb-4">Your Cart</h2>

        <% if (cart && cart.length> 0) { %>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cart.forEach(function(item) { %>
                            <tr class="cart-item">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="<%= item.image %>" alt="<%= item.name %>" class="me-3">
                                        <span>
                                            <%= item.name %>
                                        </span>
                                    </div>
                                </td>
                                <td>£<%= item.price.toFixed(2) %>
                                </td>
                                <td>
                                    <form action="/cart/update" method="POST" class="d-inline">
                                        <input type="hidden" name="productId" value="<%= item.productId %>">
                                        <input type="number" name="quantity" value="<%= item.quantity %>" min="1"
                                            style="width: 60px;" class="form-control d-inline">
                                        <button type="submit" class="btn btn-sm btn-secondary">Update</button>
                                    </form>
                                </td>
                                <td>£<%= (item.price * item.quantity).toFixed(2) %>
                                </td>
                                <td>
                                    <form action="/cart/remove" method="POST" class="d-inline">
                                        <input type="hidden" name="productId" value="<%= item.productId %>">
                                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end"><strong>Grand Total:</strong></td>
                            <td colspan="2"><strong>£<%= total.toFixed(2) %></strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="/" class="btn btn-secondary">Continue Shopping</a>
                <a href="/order/preview" class="btn btn-primary">Proceed to Checkout</a>
            </div>
            <% } else { %>
                <div class="text-center py-5">
                    <h4 class="text-muted">Your cart is empty</h4>
                    <a href="/" class="btn btn-primary mt-3">Start Shopping</a>
                </div>
                <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>