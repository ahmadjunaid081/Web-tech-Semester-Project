<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f8f9fa;
        }

        .sidebar {
            background: #343a40;
            min-height: 100vh;
            padding: 20px;
        }

        .sidebar a {
            color: #fff;
            text-decoration: none;
            display: block;
            padding: 10px;
            margin: 5px 0;
            border-radius: 5px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #e00;
        }

        .status-badge {
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .status-Placed {
            background: #17a2b8;
            color: #fff;
        }

        .status-Processing {
            background: #ffc107;
            color: #000;
        }

        .status-Delivered {
            background: #28a745;
            color: #fff;
        }

        .lifecycle-step {
            text-align: center;
            padding: 10px 20px;
        }

        .lifecycle-step.active {
            background: #e8f5e9;
            border-radius: 10px;
        }

        .lifecycle-step.completed {
            opacity: 0.5;
        }

        .lifecycle-arrow {
            font-size: 2rem;
            color: #ccc;
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar">
                <h4 class="text-white mb-4">Admin Panel</h4>
                <a href="/admin" class="active">📦 Orders</a>
                <a href="/">🏠 Store</a>
            </div>
            <div class="col-md-10 p-4">
                <a href="/admin" class="btn btn-secondary mb-3">← Back to Orders</a>

                <h2 class="mb-4">Order Details</h2>

                <% if (typeof req !=='undefined' && req.query && req.query.success) { %>
                    <div class="alert alert-success">
                        <%= req.query.success %>
                    </div>
                    <% } %>
                        <% if (typeof req !=='undefined' && req.query && req.query.error) { %>
                            <div class="alert alert-danger">
                                <%= req.query.error %>
                            </div>
                            <% } %>

                                <!-- Order Info -->
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Order ID:</strong>
                                                    <%= order._id %>
                                                </p>
                                                <p><strong>Customer Email:</strong>
                                                    <%= order.customerEmail %>
                                                </p>
                                                <p><strong>Date:</strong>
                                                    <%= order.createdAt.toLocaleString() %>
                                                </p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Subtotal:</strong> £<%= order.subtotal.toFixed(2) %>
                                                </p>
                                                <% if (order.discountApplied) { %>
                                                    <p><strong>Discount:</strong> -£<%= order.discountAmount.toFixed(2)
                                                            %> (<%= order.discountCode %>)</p>
                                                    <% } %>
                                                        <p><strong>Total:</strong> <span class="text-danger fw-bold">£
                                                                <%= order.totalAmount.toFixed(2) %></span></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status Lifecycle Visual -->
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Order Status Lifecycle</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex justify-content-center align-items-center gap-3">
                                            <% ORDER_STATUSES.forEach(function(status, index) { %>
                                                <div class="lifecycle-step 
                                    <%= order.status === status ? 'active' : '' %>
                                    <%= ORDER_STATUSES.indexOf(order.status) > index ? 'completed' : '' %>">
                                                    <span class="status-badge status-<%= status %>">
                                                        <%= status %>
                                                    </span>
                                                    <% if (order.status===status) { %>
                                                        <div class="mt-2 text-success"><strong>← Current</strong></div>
                                                        <% } %>
                                                </div>
                                                <% if (index < ORDER_STATUSES.length - 1) { %>
                                                    <span class="lifecycle-arrow">→</span>
                                                    <% } %>
                                                        <% }); %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status Update -->
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0">Update Status</h5>
                                    </div>
                                    <div class="card-body">
                                        <% if (nextStatus) { %>
                                            <p>Current Status: <span class="status-badge status-<%= order.status %>">
                                                    <%= order.status %>
                                                </span></p>
                                            <p>Next Status: <span class="status-badge status-<%= nextStatus %>">
                                                    <%= nextStatus %>
                                                </span></p>

                                            <form action="/admin/orders/<%= order._id %>/advance-status" method="POST"
                                                class="d-inline">
                                                <button type="submit" class="btn btn-success btn-lg">
                                                    Advance to <%= nextStatus %> →
                                                </button>
                                            </form>

                                            <p class="text-muted mt-3"><em>Note: You can only advance to the next
                                                    status. Skipping is not allowed.</em></p>
                                            <% } else { %>
                                                <div class="alert alert-success">
                                                    <strong>✓ Order Complete!</strong> This order has reached the final
                                                    status:
                                                    <span class="status-badge status-<%= order.status %>">
                                                        <%= order.status %>
                                                    </span>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>

                                <!-- Order Items -->
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="mb-0">Order Items</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th>Qty</th>
                                                    <th>Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% order.items.forEach(function(item) { %>
                                                    <tr>
                                                        <td>
                                                            <%= item.name %>
                                                        </td>
                                                        <td>
                                                            <%= item.quantity %>
                                                        </td>
                                                        <td>£<%= (item.price * item.quantity).toFixed(2) %>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
            </div>
        </div>
    </div>
</body>

</html>