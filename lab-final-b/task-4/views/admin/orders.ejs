<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f8f9fa;
        }

        .sidebar {
            background: #343a40;
            min-height: 100vh;
            padding: 20px;
        }

        .sidebar a {
            color: #fff;
            text-decoration: none;
            display: block;
            padding: 10px;
            margin: 5px 0;
            border-radius: 5px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #e00;
        }

        .status-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-weight: bold;
        }

        .status-Placed {
            background: #17a2b8;
            color: #fff;
        }

        .status-Processing {
            background: #ffc107;
            color: #000;
        }

        .status-Delivered {
            background: #28a745;
            color: #fff;
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar">
                <h4 class="text-white mb-4">Admin Panel</h4>
                <a href="/admin" class="active">📦 Orders</a>
                <a href="/">🏠 Store</a>
            </div>
            <div class="col-md-10 p-4">
                <h2 class="mb-4">Order Management - Status Lifecycle</h2>

                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success">
                        <%= success %>
                    </div>
                    <% } %>
                        <% if (typeof error !=='undefined' && error) { %>
                            <div class="alert alert-danger">
                                <%= error %>
                            </div>
                            <% } %>

                                <!-- Status Lifecycle Legend -->
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <h5>Order Status Lifecycle:</h5>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="status-badge status-Placed">Placed</span>
                                            <span>→</span>
                                            <span class="status-badge status-Processing">Processing</span>
                                            <span>→</span>
                                            <span class="status-badge status-Delivered">Delivered</span>
                                        </div>
                                        <p class="text-muted mt-2 mb-0">Orders can only advance one step at a time. No
                                            skipping allowed!</p>
                                    </div>
                                </div>

                                <!-- Orders Table -->
                                <div class="card">
                                    <div class="card-body">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Order ID</th>
                                                    <th>Email</th>
                                                    <th>Total</th>
                                                    <th>Status</th>
                                                    <th>Date</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (orders && orders.length> 0) { %>
                                                    <% orders.forEach(function(order) { %>
                                                        <tr>
                                                            <td><code><%= order._id.toString().slice(-8) %></code></td>
                                                            <td>
                                                                <%= order.customerEmail %>
                                                            </td>
                                                            <td>£<%= order.totalAmount.toFixed(2) %>
                                                            </td>
                                                            <td><span class="status-badge status-<%= order.status %>">
                                                                    <%= order.status %>
                                                                </span></td>
                                                            <td>
                                                                <%= order.createdAt.toLocaleDateString() %>
                                                            </td>
                                                            <td>
                                                                <a href="/admin/orders/<%= order._id %>"
                                                                    class="btn btn-sm btn-primary">
                                                                    Manage
                                                                </a>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="6" class="text-center text-muted">No
                                                                        orders yet</td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
            </div>
        </div>
    </div>
</body>

</html>